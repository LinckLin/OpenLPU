//===- qnn.td - QNN layer dialect (Transformer semantic ops) -------------===//
//
// QCore dialect 1/3: qnn — retains Transformer semantics before lowering.
// Ops: matmul / attention / rmsnorm / rope / swiglu.
// Lowering path: qnn -> qisa (compiler/qisa.td) -> Q-ISA asm (compiler/isa/).
//
//===----------------------------------------------------------------------===//
#ifndef QNN_TD
#define QNN_TD

include "mlir/IR/OpBase.td"
include "mlir/IR/AttrTypeBase.td"

def QNN_Dialect : Dialect {
  let name = "qnn";
  let cppNamespace = "::mlir::qnn";
  let summary = "QNN layer dialect: matmul/attention/rmsnorm/rope/swiglu";
  let description = [{
    High-level Transformer semantic ops. Each op maps to a lowering pass that
    emits the qisa dialect (compiler/qisa.td), which in turn maps 1:1 to the
    frozen 33-instruction Q-ISA (docs/spec-src/02-isa.md).
  }];
}

class QNN_Op<string mnemonic, list<Trait> traits = []>
    : Op<QNN_Dialect, mnemonic, traits>;

// qnn.matmul: C = x @ W^T (linear layer). Weight [N, K] stored PyTorch-style
// [out, in]; lowered to GEMM (PF) / GEMV (DC) tiles with transpose_B=1.
def QNN_MatmulOp : QNN_Op<"matmul", []> {
  let summary = "dense linear layer C = x @ W^T (+ optional bias)";
  let arguments = (ins
    AnyTensor:$x,                // [M, K] activation (BF16/INT8)
    AnyTensor:$weight,           // [N, K] weight (BF16/INT8), PyTorch [out, in]
    Optional<AnyTensor>:$bias,   // [N] fp32 bias (added in fp domain)
    OptionalAttr<I32Attr>:$group // per-128-group size for INT8 dequant (128)
  );
  let results = (outs AnyTensor:$y);   // [M, N]
  let assemblyFormat = "$x `,` $weight (`,` $bias^)? attr-dict `:` "
      "type($x) `,` type($weight) (`,` type($bias)^)? `->` type($y)";
}

// qnn.rmsnorm: y = (x / rms(x)) * gamma. mode: normal (input norm) or per-head
// (QK-norm, group of 128).
def QNN_RMSNormOp : QNN_Op<"rmsnorm"> {
  let summary = "RMSNorm y = x / sqrt(mean(x^2)+eps) * gamma";
  let arguments = (ins
    AnyTensor:$x,              // [M, L]
    AnyTensor:$gamma,          // [L]
    F32Attr:$eps,              // rms_norm_eps (1e-6)
    I32Attr:$mode              // 0 = normal, 1 = per-head (group 128)
  );
  let results = (outs AnyTensor:$y);
  let assemblyFormat = "$x `,` $gamma attr-dict `:` type($x) `,` type($gamma)"
      " `->` type($y)";
}

// qnn.rope: rotary position embedding, single position (decode) or block
// (prefill, lowered to per-position ROPE).
def QNN_RopeOp : QNN_Op<"rope"> {
  let summary = "RoPE: rotate pairs by theta_i = pos * theta^(-2i/128)";
  let arguments = (ins
    AnyTensor:$x,       // [M, heads*head_dim]
    F32Attr:$theta,     // rope_theta (1e6)
    I32Attr:$pos,       // position (0..40959)
    I32Attr:$head_dim   // 128
  );
  let results = (outs AnyTensor:$y);
  let assemblyFormat = "$x attr-dict `:` type($x) `->` type($y)";
}

// qnn.swiglu: h = silu(gate) * up.
def QNN_SwiGLUOp : QNN_Op<"swiglu"> {
  let summary = "SwiGLU: h = silu(gate) * up";
  let arguments = (ins AnyTensor:$gate, AnyTensor:$up);
  let results = (outs AnyTensor:$h);
  let assemblyFormat = "$gate `,` $up attr-dict `:` type($gate) `,` type($up)"
      " `->` type($h)";
}

// qnn.attention: causal multi-head attention with GQA. High-level op covering
// QK^T, mask, softmax, AV; lowered to BMM + VMASK + VECTOR softmax + KV ops.
def QNN_AttentionOp : QNN_Op<"attention", []> {
  let summary = "causal GQA attention (QK^T -> mask -> softmax -> AV)";
  let arguments = (ins
    AnyTensor:$q,              // [M, q_heads*head_dim]
    AnyTensor:$k,              // [M, kv_heads*head_dim]
    AnyTensor:$v,              // [M, kv_heads*head_dim]
    Optional<AnyTensor>:$mask, // causal mask (or generated by VMASK)
    F32Attr:$scale,            // attn_scale = head_dim^-0.5
    I32Attr:$q_heads,
    I32Attr:$kv_heads,
    I32Attr:$head_dim
  );
  let results = (outs AnyTensor:$ctx);   // [M, q_heads*head_dim]
  let assemblyFormat = "$q `,` $k `,` $v (`,` $mask^)? attr-dict `:` "
      "type($q) `,` type($k) `,` type($v) (`,` type($mask)^)? `->` type($ctx)";
}

#endif // QNN_TD
